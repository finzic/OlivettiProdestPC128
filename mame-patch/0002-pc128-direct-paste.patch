+/* Clipboard paste. Characters are handed to the monitor's GETC routine
+   (SWI $0A, second monitor page) instead of being pressed on the key matrix,
+   so the ROM receives each one exactly when it asks for the next key and
+   nothing is lost while BASIC stores a line or scrolls the screen.
+   GETC starts at $F520 (LDA <$5C) and every exit runs
+   $F629: CLR <$5C / $F62B: STB 4,S / RTS, where B is the key returned (0 = none).
+   While text is pending, the opcode fetch at $F520 is replaced by LBRA $F629
+   with B already holding the next character, skipping the keyboard scan and
+   its debounce delay. The $F62B tap covers GETC calls that could not be
+   short-circuited (a multi-byte key sequence in progress).
+   The machine runs unthrottled until the pasted text is consumed. */
+
+bool mo6_state::mo6_paste(std::string_view text)
+{
+	m_paste_text.erase(0, m_paste_pos);
+	m_paste_pos = 0;
+	bool after_cr = false;
+	for (char const c : text)
+	{
+		uint8_t const ch = uint8_t(c);
+		if (ch == '\n')
+		{
+			if (!after_cr)
+				m_paste_text += '\r';
+			after_cr = false;
+			continue;
+		}
+		after_cr = (ch == '\r');
+		if (ch == '\r')
+			m_paste_text += '\r';
+		else if (ch == '\t')
+			m_paste_text += ' ';
+		else if (ch >= 0x20 && ch < 0x7f)
+			m_paste_text += char(ch);
+	}
+	if (!m_paste_text.empty() && !m_paste_unthrottled && machine().video().throttled())
+	{
+		machine().video().set_throttled(false);
+		m_paste_unthrottled = true;
+	}
+	return true;
+}
+
+void mo6_state::mo6_paste_done()
+{
+	m_paste_text.clear();
+	m_paste_pos = 0;
+	m_paste_lbra = false;
+	if (m_paste_unthrottled)
+	{
+		machine().video().set_throttled(true);
+		m_paste_unthrottled = false;
+	}
+}
+
+bool mo6_state::mo6_paste_rom_ok() const
+{
+	uint8_t const *const rom = static_cast<uint8_t const *>(m_biosbank->base());
+	return rom[0x520] == 0x96 && rom[0x521] == 0x5c &&
+			rom[0x629] == 0x0f && rom[0x62a] == 0x5c && rom[0x62b] == 0xe7 && rom[0x62c] == 0x64 && rom[0x62d] == 0x39;
+}
+
+void mo6_state::mo6_paste_next_char()
+{
+	m_maincpu->set_state_int(M6809_B, uint8_t(m_paste_text[m_paste_pos++]));
+	if (m_paste_pos >= m_paste_text.size())
+		mo6_paste_done();
+}
+
+void mo6_state::mo6_paste_entry_tap(offs_t offset, uint8_t &data)
+{
+	if (machine().side_effects_disabled())
+		return;
+
+	if (offset == 0xf520)
+	{
+		m_paste_lbra = false;
+		if (m_paste_pos >= m_paste_text.size() || !mo6_paste_rom_ok())
+			return;
+
+		// no pending accent/control sequence ($5C, $5D with DP=$20)
+		address_space &space = m_maincpu->space(AS_PROGRAM);
+		if (space.read_byte(0x205c) >= 0x20 || space.read_byte(0x205d) != 0)
+			return;
+
+		mo6_paste_next_char();
+		m_paste_lbra = true;
+		data = 0x16;                    // LBRA
+	}
+	else if (m_paste_lbra)
+	{
+		// offset $F629 - $F523
+		if (offset == 0xf521)
+			data = 0x01;
+		else
+		{
+			data = 0x06;
+			m_paste_lbra = false;
+		}
+	}
+}
+
+void mo6_state::mo6_paste_exit_tap(uint8_t data)
+{
+	if (m_paste_pos >= m_paste_text.size() || machine().side_effects_disabled())
+		return;
+	if (data != 0xe7 || !mo6_paste_rom_ok() || m_maincpu->state_int(M6809_B) != 0)
+		return;
+	mo6_paste_next_char();
+}
+
+
+
