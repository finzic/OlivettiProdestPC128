{
  // On Windows replace "python3" with "py" (or your interpreter).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PC128: run BASIC (current file)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/pc128.py", "basic", "${file}", "--done-addr", "9F01", "--dump", "9F00:16"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: renumber BASIC (current file)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/renumber.py", "${file}"],
      "presentation": { "reveal": "silent", "revealProblems": "onProblem", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: renumber BASIC (choose start/step)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/renumber.py", "${file}", "--start", "${input:renumStart}", "--step", "${input:renumStep}"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: run ASM (current file)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/pc128.py", "asm", "${file}", "--done-addr", "9F01", "--dump", "9F00:16"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: run ASM (choose memory dump)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/pc128.py", "asm", "${file}", "--dump", "${input:dumpSpec}"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: start MAME session (CD90-351 default)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/tools/run-mame.sh", "${input:mediaKind}", "${input:mediaFile}"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "PC128: create new floppy/cassette/cartridge",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/new-media.py", "${input:newMediaKind}", "${input:newMediaPath}"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: debugger REPL (current file)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/debugger/pc128dbg.py", "${file}", "--stop"],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: debugger REPL (current file, with media)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/debugger/pc128dbg.py", "${file}", "--stop", "--media", "${input:mediaKind}", "${input:debugMediaFile}"],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: debugger REPL (bare machine)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/debugger/pc128dbg.py"],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "PC128: build + install debugger extension",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/vscode-pc128-debug/build.py", "--install"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "renumStart",
      "type": "promptString",
      "description": "First line number",
      "default": "10"
    },
    {
      "id": "renumStep",
      "type": "promptString",
      "description": "Line number increment",
      "default": "10"
    },
    {
      "id": "newMediaKind",
      "type": "pickString",
      "description": "Kind of blank medium to create",
      "options": ["floppy", "cassette", "cartridge"],
      "default": "floppy"
    },
    {
      "id": "newMediaPath",
      "type": "promptString",
      "description": "New image path (.fd / .wav / .rom)",
      "default": "${workspaceFolder}/build/new.fd"
    },
    {
      "id": "mediaKind",
      "type": "pickString",
      "description": "Choose floppy351 for the primary 80-track CD90-351; floppy is the 40-track CD90-640 fallback",
      "options": ["floppy351", "floppy", "cassette", "cartridge", "none"],
      "default": "floppy351"
    },
    {
      "id": "mediaFile",
      "type": "promptString",
      "description": "Image path (.fd / .k7 .wav / .rom .m5); ignored for 'none'",
      "default": "${file}"
    },
    {
      "id": "debugMediaFile",
      "type": "promptString",
      "description": "Image path (.fd / .k7 .wav / .rom .m7); ignored for 'none'",
      "default": "${workspaceFolder}/media/"
    },
    {
      "id": "dumpSpec",
      "type": "promptString",
      "description": "Memory to dump as HEXADDR:LENGTH",
      "default": "9F00:16"
    }
  ]
}
